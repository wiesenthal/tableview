{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TableView",
  "version": "0.1.0",
  "identifier": "com.zwies.tableview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TableView",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "transparent": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 19
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Zach Wiesenthal. MIT License.",
    "shortDescription": "A fast macOS database client with Claude built in",
    "longDescription": "TableView is a TablePlus-style database client for Postgres, MySQL and SQLite, with a Claude chat panel and an MCP server for Claude Code.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {}
  }
}
